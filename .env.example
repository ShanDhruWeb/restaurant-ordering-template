# Copy this file to .env and fill in the values. Never commit .env.
# Full explanation of every variable: docs/ENV.md

# --- Database (PostgreSQL) ---
# Pooled connection string, used by the running app (Neon: host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional. A SEPARATE, disposable database for integration tests (tests wipe all tables).
# Leave empty to skip integration tests. Must never point at the dev or production database.
DATABASE_URL_TEST=""

# --- Razorpay (from the restaurant's own Razorpay dashboard) ---
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# The secret you type when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=""
# Local development only: "true" simulates Razorpay so no keys are needed. Refused in production.
RAZORPAY_MOCK="true"
# Production only: set "true" to allow rzp_test_ keys in production (e.g. a staging site).
ALLOW_TEST_KEYS=""

# --- App ---
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Public URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Protects /api/cron/reconcile. At least 16 random characters.
CRON_SECRET=""

# --- Optional ---
# Error reporting. Leave empty to disable.
SENTRY_DSN=""
